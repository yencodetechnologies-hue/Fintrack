MONGO_URI=mongodb://localhost:27017/fintrack
PORT=3009

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-smtp@gmail.com
SMTP_PASS=your-app-password

# Firebase (existing)
FIREBASE_TYPE=service_account
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=
FIREBASE_CLIENT_ID=
FIREBASE_AUTH_URI=https://accounts.google.com/o/oauth2/auth
FIREBASE_TOKEN_URI=https://oauth2.googleapis.com/token

# Google OAuth for Gmail bill sync
# Create at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=https://fintrack.yencodetechnologies.in/api/email/oauth/callback
# 32-byte hex key: openssl rand -hex 32
GMAIL_TOKEN_ENCRYPTION_KEY=
# Deep link after OAuth (Flutter app)
APP_OAUTH_SUCCESS_URL=fintrack://oauth/success
APP_OAUTH_ERROR_URL=fintrack://oauth/error
